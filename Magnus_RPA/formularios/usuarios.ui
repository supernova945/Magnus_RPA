    width: 16px;
    height: 16px;
    border-radius: 8px;
    border: 1.5px solid #1877F2;
    background-color: #0D1117;
}
QRadioButton::indicator:hover {
    border: 1.5px solid #4FA3F7;
    background-color: #1A2236;
}
QRadioButton::indicator:checked {
