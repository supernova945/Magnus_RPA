       <string notr="true">
/* ── Contenedores padre e hijo ── */
#slide_menu_contanier, #silde_menu {
    background-color: #161B27;
    border: none;
}
#slide_menu_contanier {
    border-right: 1px solid #232B3E;
}

/* ── Barra degradado superior ── */
#silde_menu #top_accent {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
        stop:0 #1877F2, stop:0.5 #4FA3F7, stop:1 #075E54);
    border: none;
}

/* ── Label título ── */
#silde_menu QLabel {
    color: #1877F2;
    font-family: &quot;72&quot;;
    font-weight: bold;
    padding: 15px 10px;
    background: transparent;
    border: none;
}

/* ── Botones generales ── */
#silde_menu QPushButton {
    background-color: transparent;
    color: #A8B8D8;
    font-size: 14px;
    text-align: left;
    padding: 12px 14px;
    border: none;
    margin: 2px 8px;
}

#silde_menu QPushButton:hover {
    background-color: #1E2840;
    color: #1877F2;
    border-bottom: 2px solid #1877F2;
}
