          <string notr="true">
QFrame#header_frame {
    background-color: #161B27;
    border: none;
    border-bottom: 1px solid #232B3E;
}

/* ── Barra de acento del header ── */
QFrame#header_top_accent {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
        stop:0 #075E54, stop:1 #053D37);
    border: none;
    min-height: 4px;
    max-height: 4px;
}

/* Botones sin hover ni pressed */
QFrame#header_frame #pushButton_3,
QFrame#header_frame #pushButton_2,
QFrame#header_frame #pushButton {
    background: transparent;
    border: none;
}
