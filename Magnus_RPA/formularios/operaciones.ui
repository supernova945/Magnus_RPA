      <property name="styleSheet">
       <string notr="true">
QTableWidget#tbl_archivo {
    background-color: #161B27;
    color: #A8B8D8;
    font-family: &quot;72&quot;;
    font-size: 13px;
    border: 1.5px solid #232B3E;
    border-radius: 10px;
    padding: 4px;
    gridline-color: #1E2840;
    outline: none;
}
QTableWidget#tbl_archivo::item:selected {
    background-color: #1877F2;
    color: #FFFFFF;
}
QHeaderView::section {
    background-color: #0D1117;
    color: #1877F2;
    font-family: &quot;72&quot;;
    font-size: 13px;
    font-weight: bold;
    border: none;
    border-bottom: 2px solid #1877F2;
    padding: 6px;
}
QTableCornerButton::section {
    background-color: #0D1117;
    border: none;
    border-bottom: 2px solid #1877F2;
}
QHeaderView::section:vertical {
    border-bottom: none;
    border-right: 2px solid #1877F2;
}
QScrollBar:vertical {
    background: #0D1117;
    width: 6px;
    border-radius: 3px;
}
QScrollBar::handle:vertical {
    background: #232B3E;
    border-radius: 3px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover { background: #1877F2; }
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0px; }
QScrollBar:horizontal {
    background: #0D1117;
    height: 6px;
    border-radius: 3px;
}
QScrollBar::handle:horizontal {
    background: #232B3E;
    border-radius: 3px;
    min-width: 20px;
}
QScrollBar::handle:horizontal:hover { background: #1877F2; }
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal { width: 0px; }
       </string>
